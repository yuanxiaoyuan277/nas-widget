<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0D1117"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <!-- 顶部标题 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="NAS 监控"
            android:textColor="#FFFFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="登录飞牛账号，开始监控你的 NAS"
            android:textColor="#66FFFFFF"
            android:textSize="13sp" />

        <!-- 登录卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="vertical"
            android:background="@drawable/glass_card"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="飞牛访问地址"
                android:textColor="#B3FFFFFF"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/et_host"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="如 http://192.168.2.3:1223 或 https://nas.你的域名"
                android:inputType="textUri"
                android:padding="12dp"
                android:textColor="#FFFFFFFF"
                android:textColorHint="#55FFFFFF"
                android:textSize="14sp"
                android:background="@drawable/edit_bg" />

            <Button
                android:id="@+id/btn_go"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="前往登录"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="点登录后跳转手机浏览器，输账号密码授权，完成后自动跳回 App"
                android:textColor="#55FFFFFF"
                android:textSize="11sp"
                android:gravity="center" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
