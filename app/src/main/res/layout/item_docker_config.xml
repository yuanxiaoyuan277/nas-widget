<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="3dp"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <LinearLayout
        android:id="@+id/ll_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_dot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="●"
                android:textColor="#4CAF50"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/tv_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="容器"
                android:textColor="@color/app_text_primary"
                android:textSize="12sp"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="13dp"
            android:layout_marginTop="1dp"
            android:text="--"
            android:textColor="@color/app_text_hint"
            android:textSize="10sp"
            android:singleLine="true"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- 启动（停止态容器显示） -->
    <TextView
        android:id="@+id/btn_action_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:background="?attr/selectableItemBackground"
        android:text="启动"
        android:textColor="@color/app_secondary"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- 重启（运行中容器显示） -->
    <TextView
        android:id="@+id/btn_action_restart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:background="?attr/selectableItemBackground"
        android:text="重启"
        android:textColor="?attr/colorPrimary"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- 停止（运行中容器显示） -->
    <TextView
        android:id="@+id/btn_action_stop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:background="?attr/selectableItemBackground"
        android:text="停止"
        android:textColor="@color/app_danger"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- 打开 Web（运行中且有公网端口的容器显示） -->
    <TextView
        android:id="@+id/btn_action_web"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:background="?attr/selectableItemBackground"
        android:text="Web"
        android:textColor="@color/app_secondary"
        android:textSize="12sp"
        android:visibility="gone" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/cb_select"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="2dp" />

</LinearLayout>
