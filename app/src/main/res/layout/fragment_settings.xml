<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_gradient">

    <ScrollView
        android:id="@+id/settings_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- 顶部标题栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="设置"
                android:textColor="@color/app_text_primary"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 飞牛账号登录卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:background="@drawable/app_card"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="飞牛账号登录"
                android:textColor="@color/app_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_login_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="未登录"
                android:textColor="@color/app_text_primary"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btn_login"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="登录飞牛账号"
                android:textColor="@android:color/white"
                app:backgroundTint="@color/app_primary"
                app:cornerRadius="14dp" />

            <Button
                android:id="@+id/btn_open_nas_web"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="打开飞牛管理网页"
                android:textColor="@android:color/white"
                app:backgroundTint="@color/app_secondary"
                app:cornerRadius="14dp" />
        </LinearLayout>

        <!-- NAS 地址卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:background="@drawable/app_card"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NAS 监控接口地址"
                android:textColor="@color/app_text_secondary"
                android:textSize="13sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <EditText
                    android:id="@+id/et_url"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="10dp"
                    android:paddingEnd="56dp"
                    android:hint="http://192.168.2.3:19254/nas"
                    android:inputType="textUri"
                    android:textColor="@color/app_text_primary"
                    android:textColorHint="@color/app_text_hint"
                    android:textSize="14sp"
                    android:background="@drawable/edit_bg" />

                <TextView
                    android:id="@+id/btn_toggle_url"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="end|center_vertical"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="显示"
                    android:textColor="@color/app_text_secondary"
                    android:textSize="13sp" />
            </FrameLayout>

            <Button
                android:id="@+id/btn_test_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="测试连接"
                android:textColor="@android:color/white"
                app:backgroundTint="@color/app_primary"
                app:cornerRadius="14dp" />
        </LinearLayout>

        <!-- wb2api 积分卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:background="@drawable/app_card"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="wb2api 积分"
                android:textColor="@color/app_text_secondary"
                android:textSize="13sp" />

            <CheckBox
                android:id="@+id/cb_wb2api"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="在小组件显示积分"
                android:textColor="@color/app_text_primary"
                android:textSize="14sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <EditText
                    android:id="@+id/et_wb2api_base"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="10dp"
                    android:paddingEnd="56dp"
                    android:hint="http://192.168.2.3:7863"
                    android:inputType="textUri"
                    android:textColor="@color/app_text_primary"
                    android:textColorHint="@color/app_text_hint"
                    android:textSize="14sp"
                    android:background="@drawable/edit_bg" />

                <TextView
                    android:id="@+id/btn_toggle_wb2api_base"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="end|center_vertical"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="显示"
                    android:textColor="@color/app_text_secondary"
                    android:textSize="13sp" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <EditText
                    android:id="@+id/et_wb2api_key"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="10dp"
                    android:paddingEnd="56dp"
                    android:hint="api_key"
                    android:inputType="text"
                    android:textColor="@color/app_text_primary"
                    android:textColorHint="@color/app_text_hint"
                    android:textSize="14sp"
                    android:background="@drawable/edit_bg" />

                <TextView
                    android:id="@+id/btn_toggle_wb2api_key"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="end|center_vertical"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="显示"
                    android:textColor="@color/app_text_secondary"
                    android:textSize="13sp" />
            </FrameLayout>

            <Button
                android:id="@+id/btn_wb2api_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="查看积分明细"
                android:textColor="@android:color/white"
                app:backgroundTint="@color/app_primary"
                app:cornerRadius="14dp" />

            <TextView
                android:id="@+id/tv_wb2api_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/app_text_primary"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp" />
        </LinearLayout>

        <!-- 显示设置卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:background="@drawable/app_card"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="显示设置"
                android:textColor="@color/app_text_secondary"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="刷新间隔"
                        android:textColor="@color/app_text_hint"
                        android:textSize="12sp" />

                    <Spinner
                        android:id="@+id/sp_refresh"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:minHeight="0dp"
                        android:gravity="center_vertical"
                        android:paddingTop="0dp"
                        android:paddingBottom="0dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:background="@drawable/spinner_bg" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="字号(px)"
                        android:textColor="@color/app_text_hint"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/et_font_size"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:gravity="center_vertical"
                        android:inputType="number"
                        android:singleLine="true"
                        android:paddingTop="0dp"
                        android:paddingBottom="0dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:textColor="@color/app_text_primary"
                        android:textColorHint="@color/app_text_hint"
                        android:background="@drawable/edit_bg" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 通知卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:background="@drawable/app_card"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="通知"
                android:textColor="@color/app_text_secondary"
                android:textSize="13sp" />

            <CheckBox
                android:id="@+id/cb_alert"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="资源告警（CPU/内存/磁盘超阈值时提醒）"
                android:textColor="@color/app_text_primary"
                android:textSize="14sp" />

            <CheckBox
                android:id="@+id/cb_alert_sound"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="推送提示音（关闭后告警/离线/容器停止通知静音，保留通知）"
                android:textColor="@color/app_text_primary"
                android:textSize="14sp" />

            <CheckBox
                android:id="@+id/cb_monitor_notif"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="状态栏常驻监控（持续显示 CPU/内存/存储/温度）"
                android:textColor="@color/app_text_primary"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="常驻监控显示项："
                android:textColor="@color/app_text_hint"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/cb_mon_cpu"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CPU"
                    android:textColor="@color/app_text_primary"
                    android:textSize="13sp" />

                <CheckBox
                    android:id="@+id/cb_mon_mem"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="内存"
                    android:textColor="@color/app_text_primary"
                    android:textSize="13sp" />

                <CheckBox
                    android:id="@+id/cb_mon_storage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="存储"
                    android:textColor="@color/app_text_primary"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/cb_mon_temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="温度"
                    android:textColor="@color/app_text_primary"
                    android:textSize="13sp" />

                <CheckBox
                    android:id="@+id/cb_mon_net"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="网络"
                    android:textColor="@color/app_text_primary"
                    android:textSize="13sp" />

                <CheckBox
                    android:id="@+id/cb_mon_traffic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="流量"
                    android:textColor="@color/app_text_primary"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="使用率阈值(%)"
                        android:textColor="@color/app_text_hint"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/et_alert_usage"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:gravity="center_vertical"
                        android:inputType="number"
                        android:singleLine="true"
                        android:paddingTop="0dp"
                        android:paddingBottom="0dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:textColor="@color/app_text_primary"
                        android:textColorHint="@color/app_text_hint"
                        android:background="@drawable/edit_bg" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CPU 温度(°C)"
                        android:textColor="@color/app_text_hint"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/et_alert_cpu_temp"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:gravity="center_vertical"
                        android:inputType="number"
                        android:singleLine="true"
                        android:paddingTop="0dp"
                        android:paddingBottom="0dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:textColor="@color/app_text_primary"
                        android:textColorHint="@color/app_text_hint"
                        android:background="@drawable/edit_bg" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NVMe 温度(°C)"
                        android:textColor="@color/app_text_hint"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/et_alert_nvme_temp"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:gravity="center_vertical"
                        android:inputType="number"
                        android:singleLine="true"
                        android:paddingTop="0dp"
                        android:paddingBottom="0dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:textColor="@color/app_text_primary"
                        android:textColorHint="@color/app_text_hint"
                        android:background="@drawable/edit_bg" />
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/btn_alert_preset"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="阈值预设：均衡 / 宽松 / 激进"
                android:textColor="@android:color/white"
                app:backgroundTint="@color/app_secondary"
                app:cornerRadius="14dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="重复提醒间隔（同一组告警多久后再次提醒）"
                    android:textColor="@color/app_text_hint"
                    android:textSize="12sp" />

                <Spinner
                    android:id="@+id/sp_alert_repeat"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:minHeight="0dp"
                    android:gravity="center_vertical"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:background="@drawable/spinner_bg" />
            </LinearLayout>

            <CheckBox
                android:id="@+id/cb_silent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="静默时段（夜间免打扰，不推送告警）"
                android:textColor="@color/app_text_primary"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="开始(时)"
                        android:textColor="@color/app_text_hint"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/et_silent_start"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:gravity="center_vertical"
                        android:inputType="number"
                        android:singleLine="true"
                        android:paddingTop="0dp"
                        android:paddingBottom="0dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:textColor="@color/app_text_primary"
                        android:textColorHint="@color/app_text_hint"
                        android:background="@drawable/edit_bg" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="结束(时)"
                        android:textColor="@color/app_text_hint"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/et_silent_end"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:gravity="center_vertical"
                        android:inputType="number"
                        android:singleLine="true"
                        android:paddingTop="0dp"
                        android:paddingBottom="0dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:textColor="@color/app_text_primary"
                        android:textColorHint="@color/app_text_hint"
                        android:background="@drawable/edit_bg" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/btn_temp_silent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="临时静默 1 小时"
                    android:textColor="@android:color/white"
                    app:backgroundTint="@color/app_primary"
                    app:cornerRadius="14dp" />

                <TextView
                    android:id="@+id/tv_temp_silent_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:text="未开启"
                    android:textColor="@color/app_text_hint"
                    android:textSize="12sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_alert_history"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="查看告警历史"
                android:textColor="@android:color/white"
                app:backgroundTint="@color/app_primary"
                app:cornerRadius="14dp" />

            <Button
                android:id="@+id/btn_test_notif"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="发送测试通知"
                android:textColor="@android:color/white"
                app:backgroundTint="@color/app_primary"
                app:cornerRadius="14dp" />
        </LinearLayout>

        <!-- 后台保活卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:background="@drawable/app_card"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="后台保活"
                android:textColor="@color/app_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_battery_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="检查中…"
                android:textColor="@color/app_text_primary"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btn_battery_whitelist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="加入电池优化白名单"
                android:textColor="@android:color/white"
                app:backgroundTint="@color/app_primary"
                app:cornerRadius="14dp" />
        </LinearLayout>

        <!-- 外观卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:background="@drawable/app_card"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="外观"
                android:textColor="@color/app_text_secondary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_toggle_theme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="深色"
                android:textColor="@android:color/white"
                app:backgroundTint="@color/app_primary"
